{
  "name": "nodebb-plugin-quickstart",
  "version": "0.4.3",
  "description": "A starter kit for quickly creating NodeBB plugins",
  "main": "build/library.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodebb/nodebb-plugin-quickstart"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nodebb",
    "plugin",
    "quickstart",
    "shell"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "git add"
    ]
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nodebb/nodebb-plugin-quickstart/issues"
  },
  "readmeFilename": "README.md",
  "nbbpm": {
    "compatibility": "^4.14.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@types/express": "^4.17.25",
    "@types/jquery": "^3.5.34",
    "@types/nconf": "^0.10.7",
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "eslint-config-nodebb": "2.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "winston": "^3.19.0"
  }
}
